# Database Connection (Neon, Supabase, Render, or any PostgreSQL provider)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Admin Authentication for /admin
ADMIN_PASSWORD=change-this-to-a-secure-admin-password
ADMIN_SESSION_SECRET=change-this-to-a-random-secret-key-32-chars

# Public Website URL (e.g. https://your-project.vercel.app or your custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
